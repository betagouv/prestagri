---
import DsfrLayout from "../layouts/dsfrLayout.astro"
---

<DsfrLayout>
    <!-- Page Header -->
    <div class="fr-container fr-mt-8v fr-mt-md-14v fr-mb-2v fr-mb-md-8v">
        <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--center">
            <div class="fr-col-12 fr-col-md-10 fr-col-lg-8">
                <h2>Calcul de l'aide pour séjour loisir sans hébergement</h2>
                <p class="fr-text--lead">
                    Renseignez les informations fournies par l'agent dans son dossier pour calculer
                    l'aide pour un séjour en centre de loisirs sans hébergement.
                </p>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="fr-container fr-container--fluid fr-mb-md-14v">
        <div class="fr-grid-row fr-grid-row-gutters fr-grid-row--center">
            <div class="fr-col-12 fr-col-md-10 fr-col-lg-8">
                <div class="fr-container fr-background-alt--grey fr-px-md-0 fr-py-10v fr-py-md-14v">
                    <div class="fr-grid-row fr-grid-row-gutters fr-grid-row--center">
                        <div class="fr-col-12 fr-col-md-10 fr-col-lg-9">
                            <!-- Form -->
                            <div class="fr-mb-6v">
                                <form id="calculForm" action="" method="get" class="form-example">

                                    <!-- Household Information Section -->
                                    <fieldset class="fr-fieldset fr-mb-6v" aria-labelledby="menage-legend">
                                        <legend class="fr-fieldset__legend" id="menage-legend">
                                            <h3>Informations sur le ménage</h3>
                                        </legend>

                                        <div class="fr-fieldset__element fr-mb-4v">
                                            <div class="fr-input-group">
                                                <label class="fr-label" for="agent_revenu">
                                                    Revenus déclarés sur l'avis d'imposition de l'agent *
                                                </label>
                                                <input
                                                    class="fr-input"
                                                    type="number"
                                                    name="agent_revenu"
                                                    id="agent_revenu"
                                                    required
                                                    aria-required="true"
                                                />
                                            </div>
                                        </div>

                                        <div class="fr-fieldset__element fr-mb-4v">
                                            <div class="fr-input-group">
                                                <label class="fr-label" for="agent_personnes">
                                                    Nombre de personnes sur l'avis d'imposition de l'agent *
                                                </label>
                                                <input
                                                    class="fr-input"
                                                    type="number"
                                                    name="agent_personnes"
                                                    id="agent_personnes"
                                                    required
                                                    aria-required="true"
                                                />
                                            </div>
                                        </div>

                                        <!-- Optional Spouse Information -->
                                        <div class="fr-fieldset__element fr-mb-4v">
                                            <div class="fr-input-group">
                                                <label class="fr-label" for="conjoint_revenu">
                                                    Revenus du conjoint (avis d'imposition distinct)
                                                </label>
                                                <input
                                                    class="fr-input"
                                                    type="number"
                                                    name="conjoint_revenu"
                                                    id="conjoint_revenu"
                                                />
                                            </div>
                                        </div>

                                        <div class="fr-fieldset__element fr-mb-4v">
                                            <div class="fr-input-group">
                                                <label class="fr-label" for="conjoint_personnes">
                                                    Nombre de personnes sur l'avis d'imposition du conjoint
                                                </label>
                                                <input
                                                    class="fr-input"
                                                    type="number"
                                                    name="conjoint_personnes"
                                                    id="conjoint_personnes"
                                                />
                                            </div>
                                        </div>

                                        <!-- Special Conditions Checkboxes -->
                                        <div class="fr-fieldset__element fr-mb-4v">
                                            <div class="fr-checkbox-group">
                                                <input
                                                    type="checkbox"
                                                    name="beneficiaire_porteur_handicap"
                                                    id="beneficiaire_porteur_handicap"
                                                />
                                                <label class="fr-label" for="beneficiaire_porteur_handicap">
                                                    Agent ou enfant porteur de handicap
                                                </label>
                                            </div>
                                        </div>

                                        <div class="fr-fieldset__element fr-mb-4v">
                                            <div class="fr-checkbox-group">
                                                <input
                                                    type="checkbox"
                                                    name="garde_alternee"
                                                    id="garde_alternee"
                                                />
                                                <label class="fr-label" for="garde_alternee">
                                                    Enfant en garde alternée
                                                </label>
                                            </div>
                                        </div>

                                        <div class="fr-fieldset__element fr-mb-4v">
                                            <div class="fr-checkbox-group">
                                                <input
                                                    type="checkbox"
                                                    name="parent_isole"
                                                    id="parent_isole"
                                                />
                                                <label class="fr-label" for="parent_isole">
                                                    Agent parent isolé
                                                </label>
                                            </div>
                                        </div>

                                        <div class="fr-fieldset__element fr-mb-6v">
                                            <div class="fr-checkbox-group">
                                                <input
                                                    type="checkbox"
                                                    name="outre_mer"
                                                    id="outre_mer"
                                                />
                                                <label class="fr-label" for="outre_mer">
                                                    Agent vit en département d'outre-mer
                                                </label>
                                            </div>
                                        </div>
                                    </fieldset>

                                    <!-- Stay Information Section -->
                                    <fieldset class="fr-fieldset fr-mb-6v" aria-labelledby="sejour-legend">
                                        <legend class="fr-fieldset__legend" id="sejour-legend">
                                            <h3>Informations sur le séjour</h3>
                                        </legend>

                                        <div class="fr-fieldset__element fr-mb-4v">
                                            <div class="fr-input-group">
                                                <label class="fr-label" for="date_naissance">
                                                    Date de naissance de l'enfant *
                                                </label>
                                                <input
                                                    class="fr-input"
                                                    type="date"
                                                    name="date_naissance"
                                                    id="date_naissance"
                                                    required
                                                    aria-required="true"
                                                />
                                            </div>
                                        </div>

                                        <div class="fr-fieldset__element fr-mb-4v">
                                            <div class="fr-input-group">
                                                <label class="fr-label" for="date_debut_sejour">
                                                    Date de début du séjour *
                                                </label>
                                                <input
                                                    class="fr-input"
                                                    type="date"
                                                    name="date_debut_sejour"
                                                    id="date_debut_sejour"
                                                    required
                                                    aria-required="true"
                                                />
                                            </div>
                                        </div>

                                        <div class="fr-fieldset__element fr-mb-4v">
                                            <div class="fr-input-group">
                                                <label class="fr-label" for="duree_sejour">
                                                    Durée du séjour (en jours) *
                                                </label>
                                                <input
                                                    class="fr-input"
                                                    type="number"
                                                    step="0.5"
                                                    min="0"
                                                    name="duree_sejour"
                                                    id="duree_sejour"
                                                    required
                                                    aria-required="true"
                                                />
                                                <p class="fr-hint-text">
                                                    Exemple : 3.5 pour un séjour de 3 jours et demi
                                                </p>
                                            </div>
                                        </div>

                                        <div class="fr-fieldset__element fr-mb-4v">
                                            <div class="fr-input-group">
                                                <label class="fr-label" for="montant_debourse">
                                                    Montant déboursé (en euros) *
                                                </label>
                                                <input
                                                    class="fr-input"
                                                    type="number"
                                                    min="0"
                                                    name="montant_debourse"
                                                    id="montant_debourse"
                                                    required
                                                    aria-required="true"
                                                />
                                            </div>
                                        </div>

                                        <div class="fr-fieldset__element fr-mb-4v">
                                            <div class="fr-checkbox-group">
                                                <input
                                                    type="checkbox"
                                                    name="centre_agree"
                                                    id="centre_agree"
                                                    checked
                                                />
                                                <label class="fr-label" for="centre_agree">
                                                    Le centre est agréé
                                                </label>
                                            </div>
                                        </div>
                                    </fieldset>

                                    <!-- Submit Button -->
                                    <button class="fr-btn fr-mt-4v" type="submit">
                                        Calculer l'aide séjour loisir sans hébergement
                                    </button>
                                </form>
                            </div>

                            <!-- Result Display -->
                            <div class="fr-callout fr-mt-6v" id="answer" style="display:none">
                                <h3 class="fr-callout__title">Résultat du calcul</h3>
                                <p id="value" class="fr-callout__text">...</p>
                                <h4 class="fr-callout__text fr-mt-4v">Explication :</h4>
                                <p id="explanation" class="fr-callout__text">...</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</DsfrLayout>

<!-- JavaScript for form submission -->
<script>
    const calculForm = document.getElementById("calculForm");

    calculForm?.addEventListener("submit", (e) => {
        e.preventDefault();

        // Build URL with all parameters
        const params = new URLSearchParams();

        // Household parameters
        params.append("menage_agent_revenu", (document.getElementById('agent_revenu') as HTMLInputElement).value);
        params.append("menage_agent_membres", (document.getElementById('agent_personnes') as HTMLInputElement).value);
        params.append("foyer_fiscal_conjoint_revenu", (document.getElementById('conjoint_revenu') as HTMLInputElement).value || "0");
        params.append("foyer_fiscal_conjoint_membres", (document.getElementById('conjoint_personnes') as HTMLInputElement).value || "0");

        // Special conditions
        params.append("beneficiaire_porteur_handicap", String((document.getElementById('beneficiaire_porteur_handicap') as HTMLInputElement).checked));
        params.append("garde_alternee", String((document.getElementById('garde_alternee') as HTMLInputElement).checked));
        params.append("parent_isole", String((document.getElementById('parent_isole') as HTMLInputElement).checked));
        params.append("outre_mer", String((document.getElementById('outre_mer') as HTMLInputElement).checked));

        // Stay parameters
        params.append("date_naissance", (document.getElementById('date_naissance') as HTMLInputElement).value);
        params.append("date_debut_sejour", (document.getElementById('date_debut_sejour') as HTMLInputElement).value);
        params.append("duree_sejour", (document.getElementById('duree_sejour') as HTMLInputElement).value);
        params.append("montant_debourse", (document.getElementById('montant_debourse') as HTMLInputElement).value);
        params.append("centre_agree", String((document.getElementById('centre_agree') as HTMLInputElement).checked));

        const url = `http://localhost:8000/sejour_loisir_sans_hebergement?${params.toString()}`;

        console.log("Fetching:", url);

        // Fetch data from API
        fetch(url)
            .then((response) => {
                if (!response.ok) {
                    throw new Error("Erreur lors du calcul. Veuillez vérifier les informations saisies.");
                }
                return response.json();
            })
            .then((data) => {
                // Display results
                const answerElement = document.getElementById("answer");
                const valueElement = document.getElementById('value');
                const explanationElement = document.getElementById('explanation');

                if (answerElement && valueElement && explanationElement) {
                    answerElement.style.display = "block";
                    valueElement.textContent = `L'aide pour le séjour loisir sans hébergement est de ${data.value}`;
                    explanationElement.textContent = data.explanation;
                }
            })
            .catch((error) => {
                console.error("Error:", error);
                alert("Une erreur est survenue. Veuillez vérifier les informations saisies et réessayer.");
            });
    });
</script>
