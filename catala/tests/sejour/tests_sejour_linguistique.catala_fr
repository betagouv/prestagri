      -- durée_séjour_hors_vacances_scolaire: 5
      -- nb_jours_déjà_pris_en_charge_année_civile: 25
      -- montant_déboursé: 2000 €
      -- quotient_familial: 2000 €
    }
  assertion (calcul.durée_éligible = 0)
  assertion (calcul.aide = 0€)
  assertion (calcul.inéligibilité = [Famille_aisée contenu vrai; Enfant_trop_agé contenu vrai; Séjour_en_période_scolaire contenu vrai;])
```

