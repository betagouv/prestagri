    résultat de Sejour_educatif.CalculSéjourÉducatif avec {
      -- date_naissance : |1992-02-20|
      -- date_debut_sejour : |2026-02-20|
      -- durée_séjour: 3
      -- au_moins_partiellement_en_période_scolaire: faux
      -- voyages_déjà_pris_en_charge_année_civile: 2
      -- voyages_déjà_pris_en_charge_année_scolaire: 1
      -- nb_jours_déjà_pris_en_charge_année_civile: 0
      -- enfant_scolarisé: faux
