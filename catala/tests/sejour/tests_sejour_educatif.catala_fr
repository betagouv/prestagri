  assertion (calcul.inéligibilité = [Enfant_trop_agé contenu vrai; Enfant_non_scolarisé contenu vrai;  Séjour_trop_court contenu vrai; Séjour_hors_période_scolaire contenu vrai; Classe_non_agréée contenu vrai; Maximum_voyages_par_année_scolaire_atteint contenu vrai ; Maximum_voyages_par_année_civile_atteint contenu vrai])
